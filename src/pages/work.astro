---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import SectionHeader from '../components/SectionHeader.astro';
import TagPills from '../components/TagPills.astro';
import Timeline from '../components/Timeline.astro';
import Card from '../components/Card.astro';
import { withBase } from '../utils/withBase';

const workEntries = (await getCollection('work'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const toSlug = (entry: (typeof workEntries)[number]) => (entry.slug ?? entry.id).replace(/\.(md|mdx)$/, '');
---

<SiteLayout
  title="Work"
  description="Impact highlights, toolbox, and how I work across experimentation and product analytics."
>
  <section class="space-y-10">
    <SectionHeader
      eyebrow="Work"
      title="Shipping growth with measurement you can trust."
      subtitle="I focus on instrumentation, experimentation, segmentation, and causal thinking, so teams can make decisions with clarity."
    />

    <section class="grid gap-4 md:grid-cols-3">
      <Card>
        <div class="text-xs text-zinc-400">Impact</div>
        <div class="mt-2 text-sm font-medium">$4M+ quarterly inflows</div>
        <div class="mt-2 text-sm text-zinc-300">Showed slow first support replies halved deposits, leading Support to extend hours instead of hiring.</div>
      </Card>
      <Card>
        <div class="text-xs text-zinc-400">Activation</div>
        <div class="mt-2 text-sm font-medium">+3.3pp activation, +$2.4M monthly</div>
        <div class="mt-2 text-sm text-zinc-300">Cut a 5-step path to first deposit to one prompt, A/B tested with Product.</div>
      </Card>
      <Card>
        <div class="text-xs text-zinc-400">Lifecycle</div>
        <div class="mt-2 text-sm font-medium">13pp renewal lift</div>
        <div class="mt-2 text-sm text-zinc-300">Used Random Forest on usage data to find the onboarding milestones that predict renewal.</div>
      </Card>
    </section>

    <section class="grid gap-6 md:grid-cols-12">
      <div class="space-y-4 md:col-span-7">
        <h2 class="text-xl font-semibold tracking-tight">Timeline</h2>
        <Timeline
          items={[
            {
              title: 'Shakepay',
              subtitle: 'Data Scientist · Aug 2025 – Aug 2026 · Montreal',
              accent: 'indigo',
              bullets: [
                'Grew quarterly inflows $4M+ by showing that slow first support replies halved deposits, leading Support to extend hours instead of hiring.',
                'Raised new-customer activation 3.3pp (est. +$2.4M monthly inflows) by cutting a 5-step path to first deposit to one prompt, A/B tested with Product.',
                'Cut quarterly planning in half by building an inflows North Star metric hierarchy for 1.5M+ customers, now used by Product, Engineering, Marketing, Sales, and Operations for experiments and GTM.',
                'Standardized experimentation from full rollouts to A/B and multivariate tests, with stratified randomization and sequential vs. fixed-horizon designs.',
                'Found multi-product customers retained 2x monthly, making weekly multi-product users the company’s growth metric.',
                'Lifted top-tier loyalty retention 60% → 67% by replacing a lagging tier goal with an actionable leading indicator.',
                'Cut ad-hoc data requests 50%+ by building AI skills (Codex) that turn PM and engineering ideas into sized A/B test briefs.'
              ]
            },
            {
              title: 'Autodesk',
              subtitle: 'Data Analyst · Nov 2022 – Aug 2025 · Montreal',
              accent: 'indigo',
              bullets: [
                'Lifted renewal rate 13pp by using Random Forest on usage data to find the onboarding milestones that predict renewal, adopted by Lifecycle Marketing, Customer Success, and Sales.',
                'Cut churn 11% by setting inactivity thresholds from usage data and partnering with Marketing to redesign re-engagement campaigns.',
                'Sized a $20M cross-sell opportunity across 10K+ accounts by showing renewal timing and seat growth, not company size, predicted expansion.',
                'Scaled A/B testing 5x across cross-functional teams by surfacing renewal signals that became their test hypotheses.'
              ]
            }
          ]}
        />
      </div>

      <div class="space-y-4 md:col-span-5">
        <h2 class="text-xl font-semibold tracking-tight">Toolbox</h2>
        <Card>
          <TagPills
            tags={[
              'SQL',
              'Python',
              'Snowflake',
              'dbt',
              'PySpark/Snowpark',
              'Statsig',
              'PostHog',
              'Amplitude',
              'Looker',
              'Sigma',
              'Metabase',
              'Tableau',
              'Git',
              'Jira',
              'Fivetran',
              'Claude',
              'Codex',
              'Cortex'
            ]}
          />
        </Card>

        <h2 class="text-xl font-semibold tracking-tight">How I work</h2>
        <div class="grid gap-3">
          {[
            {
              title: 'Instrumentation discipline',
              body: 'Tight event schemas, metadata standards, and trust in the numbers before optimizing outcomes.'
            },
            {
              title: 'Experiments before assumptions',
              body: 'Clear hypotheses, success metrics, guardrails, and interpretation that matches business reality.'
            },
            {
              title: 'Causal thinking',
              body: 'When A/B tests aren’t possible, I model impact with careful assumptions and sensitivity checks.'
            },
            {
              title: 'Team velocity',
              body: 'Reusable frameworks, clean reporting, and crisp narratives that help teams act quickly.'
            }
          ].map((x) => (
            <Card>
              <div class="text-sm font-medium">{x.title}</div>
              <div class="mt-2 text-sm text-zinc-300">{x.body}</div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold tracking-tight">Case studies</h2>
        <div class="text-xs text-zinc-400">{workEntries.length} entries</div>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {workEntries.map((entry) => (
          <a
            class="group rounded-2xl border border-white/10 bg-white/5 p-5 hover:bg-white/10"
            href={withBase(`/work/${toSlug(entry)}`)}
          >
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs text-zinc-400">{entry.data.company ?? 'Work'}</span>
              <span class="text-xs text-zinc-500">
                {entry.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short' })}
              </span>
            </div>
            <div class="mt-2 text-lg font-semibold tracking-tight">{entry.data.title}</div>
            {entry.data.impact?.length ? (
              <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-zinc-300">
                {entry.data.impact.slice(0, 2).map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            ) : (
              <div class="mt-3 text-sm text-zinc-300">Read more.</div>
            )}
            <div class="mt-4 text-xs text-zinc-400 group-hover:text-zinc-200">Read →</div>
          </a>
        ))}
      </div>
    </section>
  </section>
</SiteLayout>

